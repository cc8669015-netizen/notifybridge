<Page
    x:Class="NotifyBridge.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="StretchItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Pivot Title="NotifyBridge">

        <PivotItem Header="Local (same Wi-Fi)">
            <Grid Margin="4,16,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#142B2D42" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Instant, but only works while this app is open and both devices are on the same Wi-Fi. On your Android phone's Local address field, enter:" Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock x:Name="AddressText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock x:Name="NoWifiText" Foreground="#E5533D" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" Text="No Wi-Fi address found. Connect to Wi-Fi (not mobile data) and reopen the app." />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch x:Name="ServerToggle" OnContent="Listening" OffContent="Stopped" Toggled="ServerToggle_Toggled" />
                    <TextBlock Grid.Column="1" x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Margin="12,0,0,0" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,16,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recent notifications" FontSize="18" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="Clear" Click="Clear_Click" />
                </Grid>

                <ListView Grid.Row="4" x:Name="NotificationList" SelectionMode="None" ItemContainerStyle="{StaticResource StretchItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8" BorderBrush="#22808080" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Text}" Opacity="0.75" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Opacity="0.6" FontSize="12" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="4" x:Name="EmptyText" Text="Nothing yet. Turn on Listening, then send a test notification from your Android phone." Opacity="0.6" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,20,0,0" />
            </Grid>
        </PivotItem>

        <PivotItem Header="Push (anywhere)">
            <Grid Margin="4,16,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Works with the app closed and off Wi-Fi, but needs a one-time setup: a relay server you host, and this app registered with Microsoft for push (WNS). See the README before using this tab." TextWrapping="Wrap" Opacity="0.85" />

                <TextBox Grid.Row="1" x:Name="ServerUrlBox" Header="Your relay server address" PlaceholderText="https://your-relay.onrender.com" InputScope="Url" Margin="0,16,0,0" TextChanged="ServerUrlBox_TextChanged" />

                <Border Grid.Row="2" Background="#142B2D42" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Pairing code — enter this on your Android phone's Relay code field:" Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock x:Name="PairingCodeText" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="3" x:Name="PushSetupButton" Content="Set up push notifications" Margin="0,16,0,0" Click="PushSetup_Click" />

                <TextBlock Grid.Row="4" x:Name="PushStatusText" Margin="0,12,0,0" Opacity="0.75" TextWrapping="Wrap" />
                <TextBlock Grid.Row="5" x:Name="IdentityText" Margin="0,12,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Grid>
        </PivotItem>

    </Pivot>
</Page>
